# ─── Relayer environment ──────────────────────────────────────────────
# The relayer is the ONLY process that holds the funded key. Run it as a
# persistent daemon (Fly.io / Railway / Render / VPS) — NOT on Vercel.

# Neon Postgres — same DATABASE_URL as the web. Use the POOLED connection
# string (hostname with "-pooler"); works for the relayer's persistent
# connections too.
DATABASE_URL=

# Funded Fuji EOA private key (the custody wallet). Sole holder.
AMP_RELAYER_KEY=

# Optional: tracing filter (e.g., "info", "debug", "amp_relayer=trace").
RUST_LOG=info
